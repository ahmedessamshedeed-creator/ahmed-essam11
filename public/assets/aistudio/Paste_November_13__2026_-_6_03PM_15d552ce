<html lang="ar" dir="rtl"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>درس موقع ومظاهر سطح قارات العالم الجديد - الصف الثالث الإعدادي</title>
    <!-- استدعاء خط احترافي -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&amp;display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #134e4a;      
            --primary-light: #0d9488; 
            --secondary: #0e7490;    
            --success: #10b981;      
            --danger: #ef4444;       
            --warning: #f59e0b;      
            --dark: #1e293b;         
            --light: #f8fafc;
            --card-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
            font-family: 'Cairo', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #ecfeff;
            background-image: radial-gradient(#a5d4ce 1.5px, transparent 1.5px);
            background-size: 25px 25px;
            color: var(--dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .hidden { display: none !important; }
        
        /* --- شاشة الترحيب الحمراء --- */
        #welcome-screen {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #7f1d1d, #dc2626, #991b1b);
            color: white;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }

        #welcome-screen.fade-out {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .enter-btn {
            background: white;
            color: #b91c1c;
            border: none;
            padding: 18px 36px;
            border-radius: 50px;
            font-size: clamp(1.2rem, 4vw, 1.6rem);
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
            transition: transform 0.2s, box-shadow 0.2s;
            font-family: 'Cairo', sans-serif;
        }

        .enter-btn:hover {
            transform: scale(1.06);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5);
        }

        .enter-btn:active {
            transform: scale(0.98);
        }

        .dev-credit {
            margin-top: 25px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #fecaca;
        }

        /* --- الهيدر الرئيسي --- */
        .header-main {
            background: linear-gradient(135deg, #042f2e, var(--primary), var(--secondary));
            color: white;
            padding: 30px 20px 90px 20px; 
            text-align: center;
            position: relative;
            margin-bottom: 20px;
        }

        .header-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .title-line1 {
            font-size: clamp(1.1rem, 4vw, 1.5rem); 
            font-weight: 700;
            color: #ccfbf1;
            margin-bottom: 5px;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-shadow: 1px 2px 4px rgba(0,0,0,0.3);
        }

        .title-line2 {
            font-size: clamp(1.4rem, 5.5vw, 2.6rem); 
            font-weight: 900;
            background: linear-gradient(to right, #2dd4bf, #0f766e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 15px;
            filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.5));
            line-height: 1.3;
            text-align: center;
        }

        .header-main h2 { font-size: clamp(1rem, 3vw, 1.3rem); font-weight: 600; color: #f0fdfa; margin-bottom: 8px; text-shadow: 1px 1px 2px rgba(0,0,0,0.3);}
        .header-main p { font-size: clamp(0.9rem, 2.5vw, 1.1rem); font-weight: 600; background: rgba(0,0,0,0.3); display: inline-block; padding: 6px 20px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 4px 6px rgba(0,0,0,0.1);}

        .header-wave {
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: auto;
            z-index: 1;
        }

        /* --- الأزرار --- */
        .btn {
            background: linear-gradient(to bottom, var(--primary-light), var(--primary));
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border-bottom: 3px solid rgba(0,0,0,0.3);
        }
        .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0,0,0,0.2); }
        .btn:active { transform: translateY(2px); border-bottom: 0px; margin-top: 3px; }
        .btn-correct { filter: brightness(1.2); pointer-events: none; border-bottom-width: 0; transform: translateY(2px);}
        .btn-wrong { filter: brightness(0.8); pointer-events: none; border-bottom-width: 0; transform: translateY(2px);}

        /* --- الشاشة الرئيسية --- */
        #home-screen {
            flex: 1;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .grid-menu {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            width: 100%;
            max-width: 1000px;
            padding-bottom: 80px;
        }

        .menu-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05), 0 4px 6px -2px rgba(0,0,0,0.025);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }
        .menu-card::before {
            content: ""; position: absolute; top: 0; left: 0; right: 0; height: 6px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            opacity: 0; transition: opacity 0.3s;
        }
        .menu-card:hover { transform: translateY(-8px); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); border-color: rgba(34, 197, 94, 0.25); }
        .menu-card:hover::before { opacity: 1; }
        
        .menu-card .icon-container {
            width: 80px; height: 80px;
            margin: 0 auto 15px auto;
            background: linear-gradient(135deg, #ccfbf1, #99f6e4);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            box-shadow: inset 0 3px 6px rgba(255,255,255,0.8), 0 4px 8px rgba(0,0,0,0.05);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .menu-card .icon-container svg {
            width: 40px; height: 40px; stroke: #134e4a; fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }
        .menu-card:hover .icon-container { transform: scale(1.1) rotate(10deg); }
        .menu-card h3 { font-size: 1.4rem; color: var(--dark); font-weight: 800; margin-bottom: 8px;}
        .menu-card p { font-size: 1rem; color: #64748b; font-weight: 600;}

        /* --- شاشة اللعب --- */
        #game-screen {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .game-nav {
            background: white;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            margin-bottom: 20px;
            font-weight: bold;
            font-size: clamp(0.9rem, 3vw, 1.2rem);
        }
        .back-btn { background: #e2e8f0; color: var(--dark); border-bottom: 3px solid #cbd5e1; padding: 8px 15px;}
        #game-progress { background: #0d9488; color: white; padding: 6px 15px; border-radius: 20px;}
        
        .game-container {
            flex: 1;
            padding: 0 20px 40px 20px;
            max-width: 900px;
            margin: 0 auto;
            width: 100%;
            display: flex;
            flex-direction: column;
        }

        .question-box {
            background: white;
            padding: 20px 25px;
            border-radius: 16px;
            text-align: center;
            font-size: clamp(1.2rem, 4vw, 1.6rem);
            font-weight: 800;
            color: #134e4a;
            margin-bottom: 25px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
            border-right: 8px solid #0e7490;
            line-height: 1.6;
        }

        .shake { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }
        @keyframes shake {
            10%, 90% { transform: translate3d(-2px, 0, 0); }
            20%, 80% { transform: translate3d(4px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
            40%, 60% { transform: translate3d(6px, 0, 0); }
        }

        /* MCQ Style */
        .options-grid { display: flex; flex-direction: column; gap: 15px; }
        .options-grid .btn { padding: 18px; font-size: clamp(1.1rem, 3.5vw, 1.4rem); text-align: right; justify-content: flex-start; border-radius: 12px;}

        /* True/False Style */
        .tf-grid { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }

        /* Bubbles Style */
        .bubbles-area {
            position: relative; height: 400px;
            background: linear-gradient(to bottom, #042f2e, #134e4a);
            border-radius: 16px; overflow: hidden;
            border: 4px solid #0d9488; margin-top: 10px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
        }
        .bubble {
            position: absolute;
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.9), rgba(224,231,255,0.9));
            color: #134e4a;
            border: 2px solid #ffffff;
            padding: 10px 5px;
            border-radius: 30px;
            font-weight: 800; font-size: clamp(0.85rem, 2vw, 1.05rem);
            box-shadow: 0 10px 15px rgba(0,0,0,0.2), inset -4px -4px 10px rgba(0,0,0,0.1);
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            text-align: center;
            width: 22%;
            transition: transform 0.2s, background 0.2s;
            z-index: 5;
        }
        .bubble:hover { transform: scale(1.05); }
        .bubble::after {
            content: ''; position: absolute; top: 10%; left: 15%;
            width: 20%; height: 20%; background: rgba(255,255,255,0.8);
            border-radius: 50%; filter: blur(2px);
        }

        /* Shooting Style */
        .shooting-area {
            position: relative; height: 400px; background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"><rect fill="%23e0fbfc" width="100%" height="100%"/><circle fill="%23bae6fd" cx="20%" cy="30%" r="50"/><circle fill="%23bae6fd" cx="80%" cy="60%" r="70"/><circle fill="%23bae6fd" cx="50%" cy="80%" r="40"/></svg>') no-repeat center center;
            background-size: cover; border-radius: 16px; overflow: hidden;
            border: 4px solid #0d9488; margin-top: 10px; box-shadow: inset 0 0 20px rgba(0,0,0,0.1);
        }
        .target-bird {
            position: absolute; background: white; color: var(--dark);
            padding: 10px 20px; border-radius: 30px; font-weight: 800; font-size: clamp(0.95rem, 3vw, 1.15rem);
            box-shadow: 0 8px 15px rgba(0,0,0,0.15); cursor: crosshair;
            border: 3px solid var(--warning); white-space: nowrap; transition: background 0.2s;
            display: flex; align-items: center; gap: 8px;
        }
        .target-bird:hover { transform: scale(1.05); background: #f0fdfa; }

        /* Genius Challenge Style */
        .genius-wrap {
            background: linear-gradient(135deg, #042f2e, #134e4a, #0f766e);
            border-radius: 16px; padding: 20px; margin-top: 10px;
            border: 4px solid #2dd4bf; box-shadow: inset 0 0 25px rgba(0,0,0,0.4), 0 10px 20px rgba(21,128,61,0.35);
        }
        .genius-timer-track {
            width: 100%; height: 14px; background: rgba(0,0,0,0.35);
            border-radius: 10px; overflow: hidden; margin-bottom: 18px;
            border: 2px solid rgba(255,255,255,0.2);
        }
        .genius-timer-bar {
            height: 100%; width: 100%;
            background: linear-gradient(to right, #2dd4bf, #0d9488, #ef4444);
            border-radius: 10px;
            transition: width 0.1s linear;
        }
        .genius-options { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        @media (max-width: 600px) { .genius-options { grid-template-columns: 1fr; } }
        .genius-options .btn {
            padding: 16px 10px; font-size: clamp(1rem, 3vw, 1.25rem);
            background: linear-gradient(to bottom, #14b8a6, #0f766e);
            border-bottom: 3px solid #134e4a; border-radius: 14px; min-height: 70px;
        }
        .genius-badge {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(74, 222, 128, 0.15); color: #2dd4bf;
            font-weight: 800; padding: 6px 16px; border-radius: 20px;
            border: 1px solid rgba(253,224,71,0.4); margin-bottom: 12px; font-size: 0.95rem;
        }

        /* Result Share (WhatsApp) */
        .share-box {
            margin-top: 25px; background: #f0fdfa; border: 2px solid #99f6e4;
            border-radius: 16px; padding: 20px; text-align: center;
        }
        .share-box h4 { color: #115e59; font-size: 1.2rem; margin-bottom: 12px; font-weight: 800;}
        .share-name-input {
            width: 100%; max-width: 320px; padding: 12px 16px; border-radius: 12px;
            border: 2px solid #5eead4; font-size: 1.05rem; text-align: center;
            font-family: 'Cairo', sans-serif; font-weight: 700; margin-bottom: 12px;
            color: var(--dark);
        }
        .share-name-input:focus { outline: none; border-color: #0d9488; }
        .btn-share {
            background: linear-gradient(to bottom, #25d366, #1da851);
            border-bottom-color: #128c3e; display: inline-flex; gap: 10px;
        }
        .share-warning { color: var(--danger); font-weight: 700; font-size: 0.9rem; margin-top: 8px; display: none; }

        /* Modal Overlay */
        .overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(4px);
            display: flex; justify-content: center; align-items: center;
            z-index: 1000; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
        }
        .overlay.active { opacity: 1; pointer-events: all; }
        .modal {
            background: white; padding: 40px; border-radius: 25px;
            text-align: center; max-width: 90%; width: 400px;
            transform: scale(0.7) translateY(50px); transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        }
        .overlay.active .modal { transform: scale(1) translateY(0); }
        .modal-icon { display: flex; justify-content: center; margin-bottom: 20px; }

        /* Summary Errors Scrolling */
        .errors-list::-webkit-scrollbar { width: 8px; }
        .errors-list::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 8px; }
        .errors-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 8px; }
        .errors-list::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* الفوتر (Footer) */
        .footer-main {
            background: var(--dark); color: #cbd5e1;
            text-align: center; padding: 25px 20px; margin-top: auto;
            border-top: 4px solid var(--primary);
        }
        .footer-main p { margin: 5px 0; font-size: 1.1rem; font-weight: 600;}
        .footer-main .designer { font-size: 1rem; color: #94a3b8; font-weight: 400;}

        /* WhatsApp */
        .whatsapp-float {
            position: fixed; bottom: 25px; left: 25px;
            background: #25d366; color: white;
            width: 65px; height: 65px; border-radius: 50%;
            display: flex; justify-content: center; align-items: center;
            text-decoration: none; box-shadow: 0 8px 15px rgba(37, 211, 102, 0.4);
            z-index: 100; transition: all 0.3s;
        }
        .whatsapp-float:hover { transform: scale(1.15) rotate(-5deg); box-shadow: 0 12px 20px rgba(37, 211, 102, 0.6); }
        .whatsapp-float svg { width: 35px; height: 35px; fill: currentColor; }

        /* Confetti effect */
        .confetti {
            position: fixed; top: -10px; width: 12px; height: 12px; z-index: 9999;
            animation: fall linear forwards; border-radius: 3px;
        }
        @keyframes fall { to { transform: translateY(110vh) rotate(720deg); opacity: 0; } }

        /* Map Challenge Style */
        .map-stage { text-align: center; margin-bottom: 18px; }
        .map-wrap { position: relative; display: inline-block; max-width: 100%; border-radius: 14px; overflow: hidden;
            border: 4px solid #0d9488; box-shadow: 0 10px 20px rgba(0,0,0,0.12); background: #fff; }
        .map-wrap img { display: block; max-width: 100%; max-height: 58vh; width: auto; height: auto; margin: 0 auto; }
        .map-mask { position: absolute; background: linear-gradient(135deg, #f59e0b, #ea580c); border: 2px solid #fff;
            border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #fff;
            font-weight: 900; font-size: clamp(0.9rem, 2.4vw, 1.4rem); box-shadow: 0 3px 8px rgba(0,0,0,0.35);
            transition: opacity 0.5s ease; animation: maskPulse 1.6s ease-in-out infinite; }
        .map-mask.revealed { opacity: 0; animation: none; }
        @keyframes maskPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
        .map-stage.zoomed { overflow: auto; -webkit-overflow-scrolling: touch; padding-bottom: 6px; }
        .map-stage.zoomed .map-wrap { max-width: none; }
        .map-stage.zoomed .map-wrap img { max-width: none; max-height: none; width: min(1400px, 230vw); }
        .map-wrap { cursor: zoom-in; }
        .map-stage.zoomed .map-wrap { cursor: zoom-out; }
        .map-hint { color: #0f766e; font-weight: 700; font-size: 0.95rem; margin-top: 8px; }
        .map-options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        @media (max-width: 600px) { .map-options { grid-template-columns: 1fr; } }
        .map-options .btn { padding: 14px 10px; font-size: clamp(1rem, 3vw, 1.2rem); min-height: 60px; }
        .map-options .btn.ok { background: linear-gradient(to bottom, #10b981, #047857) !important; }
        .map-options .btn.bad { background: linear-gradient(to bottom, #ef4444, #b91c1c) !important; }
        .header-logo { width: 260px; height: 260px; border-radius: 30px; border: 4px solid var(--warning);
            box-shadow: 0 8px 16px rgba(0,0,0,0.4); background-color: white; object-fit: contain; flex-shrink: 0; }
        @media (max-width: 600px) { .header-logo { width: 170px; height: 170px; } }

        /* اختيار طريقة اللعب + المنافسة بين فريقين */
        .mode-modal { background: white; border-radius: 24px; padding: 28px 22px; width: 460px; max-width: 92%;
            text-align: center; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.35); max-height: 92vh; overflow-y: auto; }
        .mode-modal h2 { color: var(--primary); font-size: 1.5rem; font-weight: 900; margin-bottom: 4px; }
        .mode-modal .mode-sub { color: #64748b; font-weight: 700; margin-bottom: 18px; }
        .mode-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        @media (max-width: 480px) { .mode-choices { grid-template-columns: 1fr; } }
        .mode-choice { border: 3px solid #ccfbf1; border-radius: 18px; padding: 18px 10px; cursor: pointer; background: #f0fdfa;
            transition: all .2s; font-weight: 800; color: var(--dark); }
        .mode-choice:hover { transform: translateY(-3px); border-color: var(--primary-light); }
        .mode-choice .mc-ico { font-size: 2.2rem; display: block; margin-bottom: 6px; }
        .mode-choice small { display: block; color: #64748b; font-weight: 600; margin-top: 4px; font-size: .85rem; }
        .team-setup { display: none; margin-top: 18px; text-align: right; }
        .team-setup.show { display: block; }
        .team-setup label { font-weight: 800; color: var(--primary); display: block; margin: 8px 0 4px; }
        .team-setup input { width: 100%; padding: 11px 14px; border-radius: 12px; border: 2px solid #5eead4; font-family: 'Cairo', sans-serif;
            font-size: 1.05rem; font-weight: 700; text-align: center; }
        .team-setup input:focus { outline: none; border-color: var(--primary-light); }
        .mode-actions { display: flex; gap: 10px; margin-top: 16px; }
        .mode-actions .btn { flex: 1; }
        .mode-cancel { background: #e2e8f0 !important; color: var(--dark) !important; border-bottom-color: #cbd5e1 !important; }
        .team-board { display: none; max-width: 900px; width: calc(100% - 40px); margin: -8px auto 16px; gap: 10px; }
        .team-board.show { display: flex; }
        .team-card { flex: 1; background: white; border-radius: 14px; padding: 8px 12px; display: flex; align-items: center;
            justify-content: space-between; gap: 8px; border: 3px solid transparent; box-shadow: 0 4px 10px rgba(0,0,0,.06);
            font-weight: 800; transition: all .25s; min-width: 0; }
        .team-card .tname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .team-card .tscore { font-size: 1.4rem; font-weight: 900; min-width: 36px; text-align: center; border-radius: 10px; padding: 0 8px; color: white; }
        .team-card.t0 .tscore { background: #0d9488; } .team-card.t1 .tscore { background: #ea580c; }
        .team-card.active.t0 { border-color: #0d9488; transform: scale(1.03); background: #f0fdfa; }
        .team-card.active.t1 { border-color: #ea580c; transform: scale(1.03); background: #fff7ed; }
        .team-card .turn-tag { font-size: .75rem; padding: 2px 8px; border-radius: 10px; background: #fef3c7; color: #92400e; display: none; }
        .team-card.active .turn-tag { display: inline-block; }
        .winner-box { border-radius: 20px; padding: 22px; margin: 18px 0; color: white; background: linear-gradient(135deg, #f59e0b, #ea580c); }
        .winner-box h3 { font-size: 1.8rem; font-weight: 900; }
        .final-scores { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 10px; }
        .final-scores div { background: rgba(255,255,255,.2); border-radius: 14px; padding: 8px 18px; font-weight: 800; font-size: 1.15rem; }

        /* ===== منافسة الفريقين: شاشة مقسومة ===== */
        body.duel-on { overflow: hidden; }
        .duel-screen { position: fixed; inset: 0; z-index: 500; display: flex; flex-direction: column;
            background-color: #ecfeff; background-image: radial-gradient(#a5d4ce 1.5px, transparent 1.5px); background-size: 25px 25px; }
        .duel-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: white;
            padding: 8px 14px; box-shadow: 0 4px 12px rgba(0,0,0,.06); font-weight: 800; flex-shrink: 0; }
        .duel-top strong { color: var(--primary); font-size: clamp(.95rem, 2.6vw, 1.2rem); text-align: center; flex: 1;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .duel-top .back-btn { padding: 6px 14px; font-size: 1rem; }
        .duel-top .duel-tag { background: #fef3c7; color: #92400e; border-radius: 20px; padding: 4px 12px; font-size: .85rem; white-space: nowrap; }
        .duel-halves { flex: 1; display: flex; min-height: 0; }
        .duel-half { flex: 1; min-width: 0; min-height: 0; overflow-y: auto; padding: 10px 12px 16px; display: flex;
            flex-direction: column; gap: 10px; position: relative; transition: background .3s; }
        .duel-half.t0 { background: rgba(13,148,136,.06); }
        .duel-half.t1 { background: rgba(234,88,12,.06); }
        .duel-half.flash-ok { background: rgba(16,185,129,.22); }
        .duel-half.flash-bad { background: rgba(239,68,68,.20); }
        .duel-divider { width: 6px; flex-shrink: 0; background: linear-gradient(to bottom, #0d9488, #f59e0b, #ea580c); position: relative; }
        .duel-divider span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--dark); color: #fde68a;
            font-weight: 900; border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
            border: 3px solid white; box-shadow: 0 4px 10px rgba(0,0,0,.3); font-size: .95rem; z-index: 2; }
        .dh-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: white; border-radius: 14px;
            padding: 8px 12px; box-shadow: 0 4px 10px rgba(0,0,0,.06); border: 3px solid transparent; font-weight: 800; }
        .t0 .dh-head { border-color: #0d9488; } .t1 .dh-head { border-color: #ea580c; }
        .dh-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: clamp(.95rem, 2.4vw, 1.2rem); }
        .t0 .dh-name { color: #0f766e; } .t1 .dh-name { color: #c2410c; }
        .dh-meta { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
        .dh-prog { background: #f1f5f9; color: #475569; border-radius: 10px; padding: 2px 8px; font-size: .85rem; }
        .dh-score { color: white; border-radius: 10px; padding: 0 10px; font-size: 1.3rem; font-weight: 900; min-width: 38px; text-align: center; }
        .t0 .dh-score { background: #0d9488; } .t1 .dh-score { background: #ea580c; }
        .dh-timer { display: flex; align-items: center; gap: 8px; }
        .dh-track { flex: 1; height: 12px; background: rgba(0,0,0,.12); border-radius: 10px; overflow: hidden; }
        .dh-bar { height: 100%; width: 100%; border-radius: 10px; background: linear-gradient(to right, #10b981, #f59e0b); transition: width .1s linear; }
        .dh-bar.low { background: linear-gradient(to right, #f97316, #ef4444); }
        .dh-sec { font-weight: 900; min-width: 44px; text-align: center; background: var(--dark); color: white; border-radius: 10px; padding: 1px 6px; font-size: 1rem; }
        .dh-sec.low { background: var(--danger); animation: maskPulse .8s ease-in-out infinite; }
        .duel-half .question-box { margin-bottom: 0; padding: 14px 16px; font-size: clamp(1.05rem, 2.5vw, 1.45rem); line-height: 1.55; }
        .t1 .question-box { border-right-color: #ea580c; }
        .dh-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .dh-opts .btn { padding: 12px 10px; font-size: clamp(.95rem, 2.2vw, 1.2rem); min-height: 56px; text-align: center; line-height: 1.4; }
        .t1 .dh-opts .btn { background: linear-gradient(to bottom, #f97316, #c2410c); border-bottom-color: #9a3412; }
        .dh-opts .btn.ok { background: linear-gradient(to bottom, #10b981, #047857) !important; filter: none; }
        .dh-opts .btn.bad { background: linear-gradient(to bottom, #ef4444, #b91c1c) !important; filter: none; }
        .dh-opts.tf .btn { font-size: clamp(1.3rem, 3.4vw, 1.9rem); min-height: 80px; }
        .dh-opts.tf .btn.tf-true { background: linear-gradient(to bottom, #10b981, #0e7490); border-bottom-color: #047857; }
        .dh-opts.tf .btn.tf-false { background: linear-gradient(to bottom, #ef4444, #dc2626); border-bottom-color: #b91c1c; }
        .dh-opts.locked .btn { pointer-events: none; }
        .duel-half .map-stage { margin-bottom: 0; }
        .duel-half .map-wrap img { max-height: 30vh; }
        .duel-half .map-stage.zoomed .map-wrap img { width: min(1100px, 160vw); }
        .duel-half .map-hint { font-size: .85rem; }
        .dh-verdict { text-align: center; font-weight: 900; font-size: clamp(1rem, 2.6vw, 1.3rem); min-height: 1.6em; }
        .dh-verdict.ok { color: var(--success); } .dh-verdict.bad { color: var(--danger); }
        .dh-wait { margin: auto 0; background: white; border-radius: 18px; padding: 24px 16px; text-align: center; box-shadow: 0 8px 20px rgba(0,0,0,.08); }
        .dh-wait .big { font-size: 2.6rem; }
        .dh-wait h3 { color: var(--primary); font-size: 1.35rem; font-weight: 900; margin: 6px 0; }
        .dh-wait p { color: #64748b; font-weight: 700; }
        .duel-result { position: absolute; inset: 0; z-index: 5; overflow-y: auto; padding: 16px;
            background-color: #ecfeff; background-image: radial-gradient(#a5d4ce 1.5px, transparent 1.5px); background-size: 25px 25px; }
        .duel-result .res-card { max-width: 980px; margin: 0 auto; background: white; border-radius: 20px; padding: 24px 16px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,.1); }
        .duel-result .final-scores div small { display: block; font-size: .85rem; opacity: .9; }
        .res-reviews { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; text-align: right; }
        .res-review { background: #f8fafc; border: 2px solid #e2e8f0; border-radius: 15px; padding: 12px; max-height: 320px; overflow-y: auto; }
        .res-review h4 { text-align: center; margin-bottom: 10px; font-size: 1.1rem; }
        .res-review.t0 h4 { color: #0f766e; } .res-review.t1 h4 { color: #c2410c; }
        .res-review ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; }
        .res-review li { background: white; padding: 10px; border-radius: 10px; border-right: 5px solid var(--danger); font-size: .95rem; }
        .res-review li .rq { font-weight: 800; color: var(--primary); margin-bottom: 4px; }
        .res-review li .ra { color: var(--success); font-weight: 800; }
        .res-review li .rs { color: #64748b; }
        .res-review .perfect { color: var(--success); font-weight: 800; text-align: center; }
        @media (max-width: 760px), (orientation: portrait) and (max-width: 1024px) {
            .duel-halves { flex-direction: column; }
            .duel-divider { width: auto; height: 6px; background: linear-gradient(to right, #0d9488, #f59e0b, #ea580c); }
            .duel-divider span { width: 38px; height: 38px; font-size: .8rem; }
            .duel-half { padding: 8px 10px 10px; gap: 8px; }
            .duel-half .map-wrap img { max-height: 15vh; }
            .duel-half .map-hint { display: none; }
            .duel-half .question-box { padding: 10px 12px; font-size: clamp(.95rem, 4.2vw, 1.2rem); line-height: 1.45; }
            .dh-opts .btn { min-height: 46px; padding: 8px 8px; }
            .dh-opts.tf .btn { min-height: 60px; }
        }
        @media (max-width: 420px) { .dh-opts { gap: 7px; } .dh-opts .btn { min-height: 44px; padding: 7px 6px; font-size: .92rem; } }
        @media (max-width: 640px) { .res-reviews { grid-template-columns: 1fr; } .duel-top .duel-tag { display: none; } }
    </style>
</head>
